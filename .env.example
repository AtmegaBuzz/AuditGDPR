# Copy to .env and fill in. .env is gitignored.

# Cloudflare Workers AI (used by `auditgdpr golden`)
# Account ID: Cloudflare dashboard > Workers AI (or the account home URL)
# API token: My Profile > API Tokens > "Workers AI" template (Workers AI: Read/Edit)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# pgvector DSN: matches docker-compose.yml (`docker compose up -d`). Change both if you change the compose credentials.
DATABASE_URL=postgresql://auditgdpr:auditgdpr@localhost:5432/auditgdpr
