# Copy to .env and fill in. .env is gitignored.

# Cloudflare Workers AI (used by `auditgdpr golden`)
# Account ID: Cloudflare dashboard > Workers AI (or the account home URL)
# API token: My Profile > API Tokens > "Workers AI" template (Workers AI: Read/Edit)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# pgvector DSN: matches docker-compose.yml (`docker compose up -d`). Change both if you change the compose credentials.
DATABASE_URL=postgresql://auditgdpr:auditgdpr@localhost:5432/auditgdpr

# Retrieval connects as an unprivileged Postgres role so row-level security is enforced (the admin DATABASE_URL user is a
# superuser and bypasses RLS). The role is created automatically by `auditgdpr ingest`. Change the password outside dev.
READER_PASSWORD=auditgdpr_reader
# READER_DATABASE_URL=postgresql://auditgdpr_reader:auditgdpr_reader@localhost:5432/auditgdpr   # derived from DATABASE_URL if unset

# Elasticsearch (docker compose up -d). Admin password is read by compose too; reader users are created by `auditgdpr es-sync`.
ELASTIC_PASSWORD=auditgdpr
ES_READER_PASSWORD=auditgdpr_reader
# ES_URL=http://localhost:9200
